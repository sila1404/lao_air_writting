# Feedback database configuration.
# Defaults to a local SQLite file (./lao_air_writing.db) if left unset.
# To use Postgres instead, set DATABASE_URL, e.g.:
# DATABASE_URL = postgresql+psycopg2://user:password@host:5432/dbname
# DATABASE_URL =

# Optional overrides:
# SQLITE_DB_PATH = ./lao_air_writing.db
# FEEDBACK_TABLE_NAME = feedback